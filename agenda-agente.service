[Unit]
Description=Trabalhador do agente de estudo (Ollama)
After=network.target mysql.service ollama.service agenda-estudos-api.service

[Service]
Type=simple
User=%u
WorkingDirectory=%h/AgenteDeEstudoLocal
EnvironmentFile=/etc/agenda-estudos.conf
ExecStart=%h/AgenteDeEstudoLocal/.venv/bin/python %h/AgenteDeEstudoLocal/agente_trabalhador.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
