[Unit]
Description=Envio de e-mails da agenda de estudos
After=network.target mysql.service agenda-estudos.service

[Service]
Type=simple
User=%u
WorkingDirectory=%h/AgenteDeEstudoLocal
EnvironmentFile=/etc/agenda-estudos.conf
ExecStart=%h/AgenteDeEstudoLocal/.venv/bin/python %h/AgenteDeEstudoLocal/envia_emails.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
