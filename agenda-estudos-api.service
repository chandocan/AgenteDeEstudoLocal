[Unit]
Description=API REST da agenda de estudos
After=network.target mysql.service

[Service]
Type=simple
User=%u
WorkingDirectory=%h/AgenteDeEstudoLocal
EnvironmentFile=/etc/agenda-estudos.conf
ExecStart=%h/AgenteDeEstudoLocal/.venv/bin/python %h/AgenteDeEstudoLocal/api_agenda.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
