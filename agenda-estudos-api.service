[Unit]
Description=API REST da agenda de estudos
After=network.target mysql.service

[Service]
Type=simple
User=dog_alfredo
WorkingDirectory=/home/dog_alfredo/AgenteDeEstudoLocal
EnvironmentFile=/etc/agenda-estudos.conf
ExecStart=/home/dog_alfredo/AgenteDeEstudoLocal/.venv/bin/python /home/dog_alfredo/AgenteDeEstudoLocal/api_agenda.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
